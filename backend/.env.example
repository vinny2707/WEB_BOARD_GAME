# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=

# JWT Configuration
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Password Hashing
BCRYPT_ROUNDS=10

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Email Configuration (Gmail SMTP)
# To use Gmail: Enable 2FA and create App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@boardgame.com

# OTP Configuration
OTP_EXPIRES_MINUTES=5

