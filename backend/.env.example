# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3000
USE_HTTPS=false

# ============================================
# DATABASE CONFIGURATION (Supabase PostgreSQL)
# ============================================
# Get this from Supabase Dashboard → Settings → Database → Connection String (Pooler)
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# ============================================
# JWT CONFIGURATION
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# ============================================
# PASSWORD HASHING
# ============================================
BCRYPT_ROUNDS=10

# ============================================
# CORS CONFIGURATION
# ============================================
# Development: http://localhost:5173
# Production: https://yourfrontend.vercel.app,https://www.yourdomain.com
CORS_ORIGIN=http://localhost:5173

# ============================================
# EMAIL CONFIGURATION (Resend API)
# ============================================
# Get API key from: https://resend.com/api-keys
# IMPORTANT: Use Resend API (not Gmail SMTP) for Railway deployment
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# Email sender address
# Free tier: YourApp <onboarding@resend.dev>
# Custom domain: NoReply <noreply@yourdomain.com>
EMAIL_FROM=RetroBit <onboarding@resend.dev>

# ============================================
# OTP CONFIGURATION
# ============================================
OTP_EXPIRES_MINUTES=5

# ============================================
# APPLICATION SECURITY
# ============================================
# API Key required for all /api/* requests (X-API-Key header)
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
APP_API_KEY=your-app-api-key-here

# Swagger Documentation Authentication
DOCS_USERNAME=admin
DOCS_PASSWORD=your-secure-docs-password

# ============================================
# RAILWAY DEPLOYMENT NOTES
# ============================================
# 1. DO NOT set PORT on Railway (Railway will set it automatically)
# 2. Set NODE_ENV=production on Railway
# 3. Update CORS_ORIGIN with your production frontend URL
# 4. Use Resend API (Railway blocks SMTP ports 465/587)
# 5. All variables above (except PORT, USE_HTTPS) must be set on Railway
